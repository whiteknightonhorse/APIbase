// APIbase.pro — Prisma Schema (§12.241)
// 6 core tables. 3 partitioned (daily). Partition DDL in migration SQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// agents — Registered AI agents (§12.241, §12.60, §12.175)
// ---------------------------------------------------------------------------
model Agent {
  agent_id            String   @id @default(uuid()) @db.Uuid
  api_key_hash        String   @unique @db.Char(64)
  tier                String   @default("free") // free | paid | enterprise
  status              String   @default("active") // active | suspended | deleted
  rate_limit_override Json?    @db.JsonB
  deleted_at          DateTime? @db.Timestamptz()
  created_at          DateTime @default(now()) @db.Timestamptz()
  updated_at          DateTime @updatedAt @db.Timestamptz()

  account             Account?
  executions          ExecutionLedger[]
  device_connections  DeviceConnection[]

  @@map("agents")
}

// ---------------------------------------------------------------------------
// accounts — Agent financial balances (§12.241, §12.149)
// ---------------------------------------------------------------------------
model Account {
  agent_id        String   @id @db.Uuid
  balance_usd     Decimal  @default(0) @db.Decimal(18, 8)
  is_test_account Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamptz()
  updated_at      DateTime @updatedAt @db.Timestamptz()

  agent           Agent    @relation(fields: [agent_id], references: [agent_id])

  @@map("accounts")
}

// ---------------------------------------------------------------------------
// execution_ledger — Financial audit trail, append-only (§12.241, §12.155)
// Partitioned daily by created_at. Retention: 365 days.
// Composite PK required for PostgreSQL partitioning.
// ---------------------------------------------------------------------------
model ExecutionLedger {
  execution_id       String    @default(uuid()) @db.Uuid
  agent_id           String    @db.Uuid
  tool_id            String
  status             String    // pending|running|provider_success|success|failed|timeout|shared_success|error
  billing_status     String    // RESERVED|PAID|REFUNDED|FREE
  cost_usd           Decimal   @default(0) @db.Decimal(18, 8)
  payer              String?   @db.VarChar(64) // on-chain payer wallet (x402/MPP); null for free/cache/escrow (T6 2026-06-29)
  latency_ms         Int?
  provider_called    Boolean   @default(false)
  cache_status       String?   // HIT|MISS|SHARED
  provider_latency_ms Int?
  idempotency_key    String?
  payload_url        String?
  payload_status     String?   // OK|FAILED|TIMEOUT
  // F2/C-3 (2026-09-01): set only when MODERATION blocked this request.
  // status='blocked' in that case (see moderation.stage.ts + escrow-finalize.stage.ts).
  // A blocked PAID request still settles (billing_status stays PAID) -- deliberate
  // departure from "reject as early as possible": financial consequence requires the
  // payment to have already happened (Fable decision, not to be re-litigated here).
  moderation_rule_id     String?
  moderation_category    String?
  moderation_appeal_id   String?   @db.Uuid
  created_at         DateTime  @default(now()) @db.Timestamptz()
  updated_at         DateTime? @db.Timestamptz()

  agent              Agent     @relation(fields: [agent_id], references: [agent_id])
  tool               Tool      @relation(fields: [tool_id], references: [tool_id])

  @@id([execution_id, created_at])
  @@index([agent_id, created_at])
  @@index([status, created_at])
  @@index([idempotency_key, created_at])
  @@map("execution_ledger")
}

// ---------------------------------------------------------------------------
// moderation_appeals — Content-moderation block appeals (F2/C-3, §12.43 MODERATION)
// Not partitioned: low volume, needs indefinite retention for audit + SLA tracking.
// ---------------------------------------------------------------------------
model ModerationAppeal {
  appeal_id       String    @id @default(uuid()) @db.Uuid
  execution_id    String?   @db.Uuid
  agent_id        String?   @db.Uuid
  tool_id         String
  rule_id         String
  category        String
  // OPEN -> UPHELD (block stands) | OVERTURNED (refund/unblock owed, operator-executed)
  status          String    @default("OPEN")
  contact_email   String?
  message         String?
  resolution_note String?
  created_at      DateTime  @default(now()) @db.Timestamptz()
  // Fable/operator commitment: 72h response SLA (§12.43 MODERATION step 4).
  response_due_at DateTime  @db.Timestamptz()
  resolved_at     DateTime? @db.Timestamptz()

  // ШАГ 2 (2026-09-02): what tripped the rule -- full top-level field value
  // (capped 4KB, content_truncated marks a cut), plus where in it the match
  // landed. NULL always for CSAM (category = 'csam') -- absolute exception,
  // never stored, see moderation.stage.ts's CSAM_CATEGORY guard. NULL also
  // once content_expires_at passes and the cleanup job wipes it (skeleton --
  // rule_id/category/appeal_id/status -- is kept indefinitely).
  matched_field      String?
  matched_content    String?
  content_truncated  Boolean   @default(false)
  match_start        Int?
  match_end          Int?
  // Column, not discipline: NOT NULL so a row can never silently skip
  // expiry. Set to created_at+14d here; submitAppeal() pushes it out once an
  // appeal is actually filed; the operator resolve script sets the final
  // resolved_at+30d value once a verdict lands.
  content_expires_at DateTime  @db.Timestamptz()

  @@index([status, response_due_at])
  @@index([content_expires_at])
  @@map("moderation_appeals")
}

// ---------------------------------------------------------------------------
// outbox — Async event queue (§12.241, §12.153, §9.240)
// Partitioned daily by created_at. Retention: 7 days.
// ---------------------------------------------------------------------------
model Outbox {
  id          BigInt   @default(autoincrement())
  event_type  String
  payload     Json     @db.JsonB
  processed   Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz()

  @@id([id, created_at])
  @@index([processed, created_at])
  @@map("outbox")
}

// ---------------------------------------------------------------------------
// request_metrics — Usage analytics (§12.241)
// Partitioned daily by created_at. Retention: 90 days.
// ---------------------------------------------------------------------------
model RequestMetric {
  id          BigInt   @default(autoincrement())
  agent_id    String   @db.Uuid
  tool_id     String
  status_code Int      @db.SmallInt
  duration_ms Int
  created_at  DateTime @default(now()) @db.Timestamptz()

  @@id([id, created_at])
  @@index([agent_id, created_at])
  @@map("request_metrics")
}

// ---------------------------------------------------------------------------
// tools — Tool catalog (§12.241, §12.114)
// ---------------------------------------------------------------------------
model Tool {
  tool_id   String  @id
  name      String
  provider  String
  status    String  @default("healthy") // healthy | degraded | unavailable
  price_usd Decimal @default(0) @db.Decimal(18, 8)
  cache_ttl Int     @default(300)
  // F1/C-4 (2026-09-01): real upstream cost. NULL = not yet migrated (see
  // config/tool_provider_config.yaml + scripts/migrate-upstream-cost.py) — the TOOL_STATUS
  // margin gate only enforces price_usd >= upstream_cost_usd * 1.3 where this is set.
  upstream_cost_usd Decimal? @db.Decimal(18, 8)

  executions ExecutionLedger[]

  @@map("tools")
}

// ---------------------------------------------------------------------------
// onboarding_submissions — Smart Onboarding Form (§6.12, §AP-10)
// ---------------------------------------------------------------------------
model OnboardingSubmission {
  submission_id      String   @id
  company_name       String
  api_url            String
  contact_email      String
  category           String
  description        String
  affiliate_program  String?
  monthly_volume     String?
  ip_address         String
  status             String   @default("pending")
  moderation_result  Json?    @db.JsonB
  created_at         DateTime @default(now()) @db.Timestamptz()

  @@map("onboarding_submissions")
}

// ---------------------------------------------------------------------------
// device_connections -- Ф5 physical-device layer: per-agent vendor OAuth
// account links (Tuya first). Never stores a vendor PASSWORD -- only the
// OAuth access/refresh tokens the vendor issued for the user's own account
// linking consent, and those are encrypted (AES-256-GCM, secret-crypto
// service) before they land here. `oauth_state` is the CSRF/ownership
// binding for the connect-webview's pending->active transition (see
// device-connection.service.ts); cleared once consumed. Low volume, not
// partitioned -- same class of table as moderation_appeals.
// ---------------------------------------------------------------------------
model DeviceConnection {
  connection_id      String    @id @default(uuid()) @db.Uuid
  agent_id           String    @db.Uuid
  vendor             String    // 'tuya' | 'smartthings' | 'aqara' (only 'tuya' implemented so far)
  vendor_user_id     String?   // vendor's own uid for the linked account
  status             String    @default("pending") // pending | active | revoked
  scope              String?
  // AES-256-GCM ciphertext (base64: iv || authTag || ciphertext), never plaintext.
  // NULL once revoked -- revocation wipes these columns, not just the status flag.
  access_token_enc   String?
  refresh_token_enc  String?
  token_expires_at   DateTime? @db.Timestamptz()
  // Single-use CSRF token for the pending->active OAuth callback. NULL once
  // consumed (activation) so a callback can never be replayed.
  oauth_state        String?   @unique
  created_at         DateTime  @default(now()) @db.Timestamptz()
  updated_at         DateTime  @updatedAt @db.Timestamptz()
  revoked_at         DateTime? @db.Timestamptz()

  agent              Agent     @relation(fields: [agent_id], references: [agent_id])

  @@index([agent_id, status])
  @@map("device_connections")
}
