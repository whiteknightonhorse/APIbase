// APIbase.pro — Prisma Schema (§12.241)
// 6 core tables. 3 partitioned (daily). Partition DDL in migration SQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// agents — Registered AI agents (§12.241, §12.60, §12.175)
// ---------------------------------------------------------------------------
model Agent {
  agent_id            String   @id @default(uuid()) @db.Uuid
  api_key_hash        String   @unique @db.Char(64)
  tier                String   @default("free") // free | paid | enterprise
  status              String   @default("active") // active | suspended | deleted
  rate_limit_override Json?    @db.JsonB
  deleted_at          DateTime? @db.Timestamptz()
  created_at          DateTime @default(now()) @db.Timestamptz()
  updated_at          DateTime @updatedAt @db.Timestamptz()

  account             Account?
  executions          ExecutionLedger[]
  device_connections  DeviceConnection[]

  @@map("agents")
}

// ---------------------------------------------------------------------------
// accounts — Agent financial balances (§12.241, §12.149)
// ---------------------------------------------------------------------------
model Account {
  agent_id        String   @id @db.Uuid
  balance_usd     Decimal  @default(0) @db.Decimal(18, 8)
  is_test_account Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamptz()
  updated_at      DateTime @updatedAt @db.Timestamptz()

  agent           Agent    @relation(fields: [agent_id], references: [agent_id])

  @@map("accounts")
}

// ---------------------------------------------------------------------------
// execution_ledger — Financial audit trail, append-only (§12.241, §12.155)
// Partitioned daily by created_at. Retention: 365 days.
// Composite PK required for PostgreSQL partitioning.
// ---------------------------------------------------------------------------
model ExecutionLedger {
  execution_id       String    @default(uuid()) @db.Uuid
  agent_id           String    @db.Uuid
  tool_id            String
  status             String    // pending|running|provider_success|success|failed|timeout|shared_success|error
  billing_status     String    // RESERVED|PAID|REFUNDED|FREE
  cost_usd           Decimal   @default(0) @db.Decimal(18, 8)
  // T-11 (2026-09-05): what the UPSTREAM PROVIDER itself reported this call cost us,
  // when it self-reports one (currently only api2pdf's `cost` field). NULL = the
  // provider didn't self-report (most tools) -- distinct from cost_usd above, which is
  // what WE charged the agent. Not the same column as tools.upstream_cost_usd (a
  // per-tool estimate feeding the margin gate) -- this is per-execution, real, measured.
  upstream_cost_usd  Decimal?  @db.Decimal(18, 8)
  payer              String?   @db.VarChar(64) // on-chain payer wallet (x402/MPP); null for free/cache/escrow (T6 2026-06-29)
  latency_ms         Int?
  provider_called    Boolean   @default(false)
  cache_status       String?   // HIT|MISS|SHARED
  provider_latency_ms Int?
  idempotency_key    String?
  payload_url        String?
  payload_status     String?   // OK|FAILED|TIMEOUT
  // F2/C-3 (2026-09-01): set only when MODERATION blocked this request.
  // status='blocked' in that case (see moderation.stage.ts + escrow-finalize.stage.ts).
  // A blocked PAID request still settles (billing_status stays PAID) -- deliberate
  // departure from "reject as early as possible": financial consequence requires the
  // payment to have already happened (Fable decision, not to be re-litigated here).
  moderation_rule_id     String?
  moderation_category    String?
  moderation_appeal_id   String?   @db.Uuid
  created_at         DateTime  @default(now()) @db.Timestamptz()
  updated_at         DateTime? @db.Timestamptz()

  agent              Agent     @relation(fields: [agent_id], references: [agent_id])
  tool               Tool      @relation(fields: [tool_id], references: [tool_id])

  @@id([execution_id, created_at])
  @@index([agent_id, created_at])
  @@index([status, created_at])
  @@index([idempotency_key, created_at])
  @@map("execution_ledger")
}

// ---------------------------------------------------------------------------
// moderation_appeals — Content-moderation block appeals (F2/C-3, §12.43 MODERATION)
// Not partitioned: low volume, needs indefinite retention for audit + SLA tracking.
// ---------------------------------------------------------------------------
model ModerationAppeal {
  appeal_id       String    @id @default(uuid()) @db.Uuid
  execution_id    String?   @db.Uuid
  agent_id        String?   @db.Uuid
  tool_id         String
  rule_id         String
  category        String
  // OPEN -> UPHELD (block stands) | OVERTURNED (refund/unblock owed, operator-executed)
  status          String    @default("OPEN")
  contact_email   String?
  message         String?
  resolution_note String?
  created_at      DateTime  @default(now()) @db.Timestamptz()
  // Fable/operator commitment: 72h response SLA (§12.43 MODERATION step 4).
  response_due_at DateTime  @db.Timestamptz()
  resolved_at     DateTime? @db.Timestamptz()

  // ШАГ 2 (2026-09-02): what tripped the rule -- full top-level field value
  // (capped 4KB, content_truncated marks a cut), plus where in it the match
  // landed. NULL always for CSAM (category = 'csam') -- absolute exception,
  // never stored, see moderation.stage.ts's CSAM_CATEGORY guard. NULL also
  // once content_expires_at passes and the cleanup job wipes it (skeleton --
  // rule_id/category/appeal_id/status -- is kept indefinitely).
  matched_field      String?
  matched_content    String?
  content_truncated  Boolean   @default(false)
  match_start        Int?
  match_end          Int?
  // Column, not discipline: NOT NULL so a row can never silently skip
  // expiry. Set to created_at+14d here; submitAppeal() pushes it out once an
  // appeal is actually filed; the operator resolve script sets the final
  // resolved_at+30d value once a verdict lands.
  content_expires_at DateTime  @db.Timestamptz()

  @@index([status, response_due_at])
  @@index([content_expires_at])
  @@map("moderation_appeals")
}

// ---------------------------------------------------------------------------
// outbox — Async event queue (§12.241, §12.153, §9.240)
// Partitioned daily by created_at. Retention: 7 days.
// ---------------------------------------------------------------------------
model Outbox {
  id          BigInt   @default(autoincrement())
  event_type  String
  payload     Json     @db.JsonB
  processed   Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz()

  @@id([id, created_at])
  @@index([processed, created_at])
  @@map("outbox")
}

// ---------------------------------------------------------------------------
// request_metrics — Usage analytics (§12.241)
// Partitioned daily by created_at. Retention: 90 days.
// ---------------------------------------------------------------------------
model RequestMetric {
  id          BigInt   @default(autoincrement())
  agent_id    String   @db.Uuid
  tool_id     String
  status_code Int      @db.SmallInt
  duration_ms Int
  created_at  DateTime @default(now()) @db.Timestamptz()

  @@id([id, created_at])
  @@index([agent_id, created_at])
  @@map("request_metrics")
}

// ---------------------------------------------------------------------------
// tools — Tool catalog (§12.241, §12.114)
// ---------------------------------------------------------------------------
model Tool {
  tool_id   String  @id
  name      String
  provider  String
  status    String  @default("healthy") // healthy | degraded | unavailable
  price_usd Decimal @default(0) @db.Decimal(18, 8)
  cache_ttl Int     @default(300)
  // F1/C-4 (2026-09-01): real upstream cost. NULL = not yet migrated (see
  // config/tool_provider_config.yaml + scripts/migrate-upstream-cost.py) — the TOOL_STATUS
  // margin gate only enforces price_usd >= upstream_cost_usd * 1.3 where this is set.
  upstream_cost_usd Decimal? @db.Decimal(18, 8)
  // AP-1 (2026-09-03, autopilot E5): audit trail for `status`. NULL status_source means
  // pre-autopilot / hand-set — no drive-by write ever loses "who changed this and why".
  // A `status` write with status_source='autopilot' must always set the other two together
  // (see incidents.state F2 VERIFYING->RESOLVED / STUCK for the writer, AP-8).
  status_source     String?   // manual | autopilot | seed
  status_changed_at DateTime? @db.Timestamptz()
  status_reason     String?

  executions ExecutionLedger[]

  @@map("tools")
}

// ---------------------------------------------------------------------------
// onboarding_submissions — Smart Onboarding Form (§6.12, §AP-10)
// ---------------------------------------------------------------------------
model OnboardingSubmission {
  submission_id      String   @id
  company_name       String
  api_url            String
  contact_email      String
  category           String
  description        String
  affiliate_program  String?
  monthly_volume     String?
  ip_address         String
  status             String   @default("pending")
  moderation_result  Json?    @db.JsonB
  created_at         DateTime @default(now()) @db.Timestamptz()

  @@map("onboarding_submissions")
}

// ---------------------------------------------------------------------------
// device_connections -- Ф5 physical-device layer: per-agent vendor OAuth
// account links (Tuya first). Never stores a vendor PASSWORD -- only the
// OAuth access/refresh tokens the vendor issued for the user's own account
// linking consent, and those are encrypted (AES-256-GCM, secret-crypto
// service) before they land here. `oauth_state` is the CSRF/ownership
// binding for the connect-webview's pending->active transition (see
// device-connection.service.ts); cleared once consumed. Low volume, not
// partitioned -- same class of table as moderation_appeals.
// ---------------------------------------------------------------------------
model DeviceConnection {
  connection_id      String    @id @default(uuid()) @db.Uuid
  agent_id           String    @db.Uuid
  vendor             String    // 'tuya' | 'smartthings' | 'aqara' (only 'tuya' implemented so far)
  vendor_user_id     String?   // vendor's own uid for the linked account
  status             String    @default("pending") // pending | active | revoked
  scope              String?
  // AES-256-GCM ciphertext (base64: iv || authTag || ciphertext), never plaintext.
  // NULL once revoked -- revocation wipes these columns, not just the status flag.
  access_token_enc   String?
  refresh_token_enc  String?
  token_expires_at   DateTime? @db.Timestamptz()
  // Single-use CSRF token for the pending->active OAuth callback. NULL once
  // consumed (activation) so a callback can never be replayed.
  oauth_state        String?   @unique
  created_at         DateTime  @default(now()) @db.Timestamptz()
  updated_at         DateTime  @updatedAt @db.Timestamptz()
  revoked_at         DateTime? @db.Timestamptz()

  agent              Agent     @relation(fields: [agent_id], references: [agent_id])

  @@index([agent_id, status])
  @@map("device_connections")
}

// ---------------------------------------------------------------------------
// AP-1 (2026-09-03) — autopilot durable model (see ~/AUTOPILOT-DESIGN-2026-09-03.md
// section E). `provider`/`tool_id` here are plain string keys, same convention as
// Tool.provider elsewhere — there is no `providers` table to FK against.
//
// Enum-shaped String columns (F1/F2/H3) are enforced by a CHECK constraint in the
// migration SQL, not a Postgres ENUM type or Prisma @@unique — same convention as
// tools_status_check in 0001_init. The valid value lists live in exactly two places:
// the column comment below and the CHECK constraint; migration.sql is the source the
// DB actually enforces.
// ---------------------------------------------------------------------------

// provider_status — one row per provider, durable health truth (Redis stays a cache
// in front of it). Written by the active-probe job (AP-3) and passively by real
// traffic (AP-2/AP-3). NEVER defaults pct_remaining to 100 — null means NOINFO, not
// "fine" (C0.3: "прошла" и "не запускалась" must differ in data).
model ProviderStatus {
  provider             String    @id
  state                String    // UNKNOWN | HEALTHY | DEGRADED | DOWN (F1)
  state_since          DateTime  @db.Timestamptz()
  state_reason         String?
  last_probe_at        DateTime? @db.Timestamptz()
  last_probe_result    String?   // OK | FAIL_TRANSIENT | FAIL_DETERMINISTIC | SKIPPED_BUDGET | NOINFO
  last_ok_at           DateTime? @db.Timestamptz()
  consecutive_failures Int       @default(0)
  last_latency_ms      Int?
  // Limits/burn (written by AP-5). null = NOINFO, never a silent 100.
  pct_remaining        Int?
  burn_per_hour        Decimal?  @db.Decimal(12, 2)
  exhaustion_eta       DateTime? @db.Timestamptz()
  risk                 String    @default("NOINFO") // NOINFO|NORMAL|ATTENTION|WARNING|CRITICAL|EXHAUSTED
  reliability_score    Int?      // 0-100, daily (§20)
  next_probe_at        DateTime  @db.Timestamptz() // priority queue key for active probe (AP-3)
  probe_interval_s     Int       // current adaptive interval
  // AP-3 review fix (Fable, 2026-09-03): the "401 — zero retries" pause anchor,
  // deliberately SEPARATE from last_probe_result/next_probe_at above. Those two
  // columns are written by BOTH the active probe path and tool-quality.job's
  // passive step — one field, two meanings ("last ACTIVE probe result" vs
  // "last live traffic observation"), so the passive step was silently
  // overwriting an active FAIL_DETERMINISTIC pause within ~10 minutes. This
  // column is set ONLY by an active (non-passive) FAIL_DETERMINISTIC result
  // and cleared ONLY by another active result — recordProbeResult's passive
  // path (kind='passive') never touches it, by construction, not by ordering.
  deterministic_paused_until DateTime? @db.Timestamptz()
  updated_at           DateTime  @updatedAt @db.Timestamptz()

  @@map("provider_status")
}

// probe_log — append-only record of every measurement attempt, INCLUDING the ones
// suppressed by budget (C0.5: a suppressed action is a row, not silence).
// Not partitioned: low volume (~3-5k rows/day per E2), cleaned up by
// partition-cleanup.job's existing DELETE-past-retention pattern (>90d, wired
// separately — out of AP-1's scope, this migration only creates the table).
model ProbeLog {
  id          BigInt   @id @default(autoincrement())
  provider    String
  ts          DateTime @default(now()) @db.Timestamptz()
  kind        String   // head | get | auth | usage_api | passive | suppressed
  result      String   // OK | FAIL_TRANSIENT | FAIL_DETERMINISTIC | SKIPPED_BUDGET | NOINFO
  http_status Int?
  latency_ms  Int?
  detail      String?  // e.g. "budget 4/4 spent", "401 with configured key"

  @@index([provider, ts])
  @@map("probe_log")
}

// incidents — the heart of the system (E3). The dedup lock against two fixers
// working the same fault at once is a PARTIAL UNIQUE INDEX on dedup_key WHERE
// state <> 'RESOLVED', added as raw SQL in the migration (Prisma's schema
// language cannot express a filtered unique index) — see incidents_open_dedup.
model Incident {
  incident_id     String    @id @default(uuid()) @db.Uuid
  dedup_key       String    // "<kind>:<provider>[:<tool_id>]"
  provider        String
  tool_id         String?
  // enum: AUTH_FAILED | CREDENTIAL_EXPIRED | PROVIDER_DOWN | DEGRADED_QUALITY | RATE_LIMITED | QUOTA_LOW | QUOTA_EXHAUSTED | PAYMENT_REQUIRED | API_CHANGED | ENDPOINT_CHANGED | EMAIL_NOTICE | UNKNOWN
  kind            String
  severity        String    // SEV1 (money/whole provider) | SEV2 (degradation) | SEV3 (warning)
  state           String    // OPEN | REMEDIATION_QUEUED | WAITING_HUMAN | VERIFYING | RESOLVED | STUCK (F2)
  detected_by     String    // probe | passive | limits | email | tester | manual
  evidence        Json      @db.JsonB // fact snapshot at open time; untrusted content is tagged (H4)
  attempts        Json      @default("[]") @db.JsonB // [{ts, actor, action, result}] — "what we already tried"
  fleet_task_id   String?   // NN-autopilot-... filename in taskloop
  operator_file   String?   // path, once generated (J3)
  next_recheck_at DateTime? @db.Timestamptz() // every wait has a place to expire (LAW)
  created_at      DateTime  @default(now()) @db.Timestamptz()
  updated_at      DateTime  @updatedAt @db.Timestamptz()
  resolved_at     DateTime? @db.Timestamptz()

  @@index([state, severity])
  @@map("incidents")
}

// email_events — idempotent record of every parsed inbound email (E4, H3/H4).
// `summary` is an UNTRUSTED quote (<=500 chars), never a command — see H4.
model EmailEvent {
  msg_id          String   @id // Message-ID header — idempotency key for re-reads
  received_at     DateTime @db.Timestamptz()
  from_domain     String
  provider_match  String?  // matched provider, or null
  // enum §H3: KEY_EXPIRES | KEY_REVOKED | DEPRECATION | SUNSET | ENDPOINT_CHANGE | PRICING_CHANGE | PAYMENT_FAILED | QUOTA | MAINTENANCE | SECURITY_CHANGE | ACCOUNT_ACTION | MARKETING | UNMATCHED | DEFERRED_BUDGET
  // UNMATCHED is an honest "didn't understand", not an error.
  class           String
  action_required Boolean
  incident_id     String?  @db.Uuid
  processed_at    DateTime @default(now()) @db.Timestamptz()
  summary         String?  // <=500 chars, UNTRUSTED — quote only, never a command

  @@map("email_events")
}

// autopilot_engine_heartbeat — T-04 (2026-09-04): "autopilot: OK" used to mean
// only "no open SEV1/SEV2 incidents", which is indistinguishable from "the
// engine never ran" if incidents can never have been detected either way (the
// exact defect this table closes — /tmp/autopilot-incident-engine.hb, which
// incident-engine.py already wrote every tick, lives on the HOST filesystem
// and is invisible to the containerized API: each docker-compose service gets
// its own tmpfs /tmp, confirmed live via docker-compose.yml). One row per
// engine name (currently just 'incident-engine'), upserted by
// incident-engine.py's write_heartbeat() via the same `docker exec psql`
// path every other autopilot write already uses, so it crosses the
// host->container boundary the file write cannot. See
// ENGINE_HEARTBEAT_STALE_S (src/config/autopilot.ts) for the freshness
// threshold applied to this column before GET /api/v1/incidents hands it to
// static/dashboard.html.
model AutopilotEngineHeartbeat {
  engine      String   @id // 'incident-engine' today; room for more engines later
  last_run_at DateTime @db.Timestamptz()

  @@map("autopilot_engine_heartbeat")
}
