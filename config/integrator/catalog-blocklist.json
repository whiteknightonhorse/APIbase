{
  "_comment": "layer3_only: prohibited slugs that are semantic (intent or business model), not keyword-detectable; they are enforced by the LLM review layer or a human, so they carry no category_keywords by design.",
  "instruction_patterns": [
    {
      "id": "inj-ignore-previous",
      "value": "\\bignore\\s+(all\\s+|any\\s+)?(previous|prior|above|earlier)\\b"
    },
    {
      "id": "inj-disregard",
      "value": "\\b(disregard|forget)\\s+(all\\s+|any\\s+)?(previous|prior|above|earlier|your)\\b"
    },
    {
      "id": "inj-you-must",
      "value": "\\byou\\s+must\\b"
    },
    {
      "id": "inj-system-prefix",
      "value": "(^|[\\s>\\]\\n])system\\s*:"
    },
    {
      "id": "inj-role-tag",
      "value": "<\\s*/?\\s*(system|assistant|instructions?)\\s*>"
    },
    {
      "id": "inj-url-scheme",
      "value": "\\b(javascript|vbscript|blob):|\\bdata:[a-z]+/[a-z]|\\b(http|ftp|sftp|file|ws|wss|gopher)://"
    }
  ],
