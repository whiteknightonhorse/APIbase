{
  "instruction_patterns": [
    {
      "id": "inj-ignore-previous",
      "value": "\\bignore\\s+(all\\s+|any\\s+)?(previous|prior|above|earlier)\\b"
    },
    {
      "id": "inj-disregard",
      "value": "\\b(disregard|forget)\\s+(all\\s+|any\\s+)?(previous|prior|above|earlier|your)\\b"
    },
    {
      "id": "inj-you-must",
      "value": "\\byou\\s+must\\b"
    },
    {
      "id": "inj-system-prefix",
      "value": "(^|[\\s>\\]\\n])system\\s*:"
    },
    {
      "id": "inj-role-tag",
      "value": "<\\s*/?\\s*(system|assistant|instructions?)\\s*>"
    },
