{
  "version": "1.0",
  "updated": "2026-09-02",
  "description": "Ф5 physical-device MCP layer -- full 42-class catalog descriptor, per the operator's instruction to design coverage for the whole catalog even though execution this cycle implements only T1 (Tuya OAuth). One row per device class: {class, tier, capabilities[], state_schema, limits, safety}. Calibration fields (bounds, rate_cap) are DATA here, never hardcoded in adapter code, so the operator can retune a ceiling without a deploy (§0 CLAUDE.md 'no dev-only logic', but a physical bound is an operational knob, not a code constant). vendor_examples names commonly-cited cloud platforms for orientation only -- it is not a claim any of them is wired up; see EXECUTED.md-style status in docs/09-device-mcp-layer.md for what is actually live. Bound KEYS are the real vendor DP/command code, not the abstract state_schema field name -- verified against Tuya's documented DP code only for thermostat_ac (temp_set) this cycle (the class actually implemented+tested); every other class' bound keys below are illustrative placeholders using the abstract field name and MUST be confirmed against that specific vendor's real DP code before being relied on (a guessed DP code is worse than no bound at all -- it would silently never fire).",
  "tiers": {
    "T1": {
      "label": "Ambient / low-consequence",
      "inclusion_criteria": "Fully reversible in under a few seconds, no physical-safety exposure beyond nuisance (light flicker, a few minutes of wrong temperature), no access-control or privacy function, mass consumer hardware with a real free-tier OAuth cloud already in production (Tuya/SmartThings/Aqara-class). Default posture: confirm_required=false, standard MODERATION action-class checks apply, generous rate_cap.",
      "onboarding_bar": "Vendor OAuth cloud exists, redirect_uri whitelisting is self-service or a same-day approval, a sandbox/simulated device is enough to prove the full connect->state->command->revoke scenario live."
    },
    "T2": {
      "label": "Security / access / consumable",
      "inclusion_criteria": "Either controls physical access (locks, gates, garage doors, alarm arm/disarm), captures footage/audio of a real space (cameras, doorbells), or consumes/dispenses a physical resource (water valves, pet feeders, irrigation). A wrong command can strand a person outside, expose a private space, or waste a consumable -- reversible but not free of consequence. Default posture: confirm_required=true on every state-changing command, tighter rate_cap, moderation action-class always on.",
      "onboarding_bar": "Same as T1 PLUS a documented, testable safety default (e.g. unlock always logs a confirm token; camera stream access is per-connection scoped, never a shared credential)."
    },
    "T3": {
      "label": "Financial / energy exposure",
      "inclusion_criteria": "A wrong command has a real dollar cost (charges/discharges a vehicle or battery pack, moves grid energy, runs a heater/generator) or touches equipment with its own safety interlocks the vendor already certifies (pool chemical dosing, commercial HVAC). We rely on the vendor's own hardware interlocks as the last line of defense -- our layer adds confirm + bounds, it does not replace UL/CE-certified cutoffs. Default posture: confirm_required=true, numeric bounds mandatory (no unbounded numeric command), low rate_cap.",
      "onboarding_bar": "Vendor OAuth cloud AND a written statement of the vendor's own hardware safety interlock (we do not onboard a T3 class whose vendor cloud has no independent hardware cutoff)."
    },
    "T4": {
      "label": "Mobility / industrial / lab",
      "inclusion_criteria": "Can cause physical injury or property damage through autonomous motion (drones, robot arms, mowers, lab liquid handlers), typically regulated (FAA Part 107, industrial safety standards) and normally operated through a certified integrator, not a consumer OAuth app. No consumer-cloud OAuth exists for most of this tier today.",
      "onboarding_bar": "PUBLISHED AS UNVERIFIED, never claimed working, until an actual unit + vendor account is available to prove it live (operator instruction, 2026-09-02) -- this project has no hardware and no vendor account for T4 as of this design pass, so all four T4 rows below are descriptor-only."
    }
  },
