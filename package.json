{
  "name": "apibase",
  "version": "2.2.0",
  "description": "APIbase.pro — The API Hub for AI Agents",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc && tsx scripts/shop/sync-legal-docs.ts --check",
    "start": "node dist/api/server.js",
    "dev": "tsx watch src/api/server.ts",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "knip": "knip --include exports",
    "format": "prettier --write src/",
    "migrate": "prisma migrate deploy",
    "generate": "prisma generate",
    "seed": "tsx scripts/seed.ts",
    "openapi": "tsx scripts/generate-openapi.ts"
  },
  "prisma": {
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@polymarket/clob-client": "^5.8.1",
    "@prisma/client": "^6.19.3",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/extensions": "^2.28.0",
    "bullmq": "^5.34.8",
    "ethers": "^6.17.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "fast-json-stable-stringify": "^2.1.0",
    "ioredis": "^5.4.2",
    "mppx": "^0.13.5",
    "mppx-legacy": "npm:mppx@0.8.2",
    "node-cron": "^3.0.3",
    "pg": "^8.23.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prom-client": "^15.1.3",
    "viem": "^2.57.7",
    "yaml": "^2.9.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.10",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@x402/mcp": "^2.28.0",
    "defu": "^6.1.7",
    "eslint": "^9.22.0",
    "genlayer-js": "1.1.8",
    "jest": "^30.5.2",
    "jsdom": "^24.1.3",
    "knip": "^6.41.0",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsx": "4.21.1",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "effect": "^3.20.0",
    "form-data": "4.0.6",
    "hono": "^4.13.7",
    "qs": "^6.16.0",
    "uuid": "^11.1.1",
    "esbuild": "^0.28.1",
    "smol-toml": "^1.9.0",
    "ws": "8.21.0",
    "axios": "^1.20.0",
    "ip-address": "^10.5.0",
    "fast-uri": "^3.1.7",
    "deepmerge-ts": "^8.0.2",
    "js-yaml": "^4.3.2",
    "browserslist": "^4.28.8",
    "@toon-format/toon": "^2.3.1",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^3.15.2"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "^1.1.18"
    },
    "minimatch@10.2.4": {
      "brace-expansion": "^5.0.12"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --quiet",
      "prettier --write"
    ]
  }
}
