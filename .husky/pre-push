#!/usr/bin/env sh
# Принуждение, а не инструкция. Правило про "не пушить из дерева деплоя" жило текстом в
# .claude/skills/push/SKILL.md и обходилось обычным `git push` — замерено 2026-09-03
# (`git push --dry-run` из дерева деплоя ПРОШЁЛ). Хук закрывает именно эту дыру.
#
# Дерево деплоя принадлежит скрипту деплоя (гейт грязного дерева, находка F2). Работа идёт
# в дереве флота. Пуш из дерева деплоя разводит прод на две версии.
DEPLOY_TREE="/home/apibase/apibase"
HERE="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
if [ "$HERE" = "$DEPLOY_TREE" ]; then
  echo "BLOCKED: пуш из дерева ДЕПЛОЯ ($DEPLOY_TREE) запрещён." >&2
  echo "         Работай в дереве флота и пушь оттуда." >&2
  echo "         Обойти намеренно: git push --no-verify (и объясни зачем)." >&2
  exit 1
fi
exit 0
