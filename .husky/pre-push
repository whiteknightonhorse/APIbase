#!/usr/bin/env sh
# Enforcement, not instruction. The rule "do not push from the deploy tree" lived as text in
# .claude/skills/push/SKILL.md and was bypassed by a plain `git push` — measured 2026-09-03
# (`git push --dry-run` from the deploy tree PASSED). This hook closes exactly that hole.
#
# The deploy tree belongs to the deploy script (dirty-tree gate, finding F2). Work happens
# in the fleet tree. A push from the deploy tree splits prod into two versions.
DEPLOY_TREE="/home/apibase/apibase"
HERE="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
if [ "$HERE" = "$DEPLOY_TREE" ]; then
  echo "BLOCKED: pushing from the DEPLOY tree ($DEPLOY_TREE) is forbidden." >&2
  echo "         Work in the fleet tree and push from there." >&2
  echo "         To bypass deliberately: git push --no-verify (and explain why)." >&2
  exit 1
fi
exit 0
