# Sandbox environment template (T-INT-26). Copy to .env.sandbox (untracked) and fill the blanks.
# Every blank value below is an empty placeholder; use fresh values for the sandbox and never
# reuse the production ones.
# Canonical name (INT-26 ruling-2): a non-dotenv name so fleet tooling can read and edit this template.

NODE_ENV=production
PUBLIC_BASE_URL=https://sandbox.apibase.pro
IMAGE_TAG=latest

# Own postgres and redis (service names resolve inside sandbox_net only)
POSTGRES_USER=apibase
POSTGRES_PASSWORD=
POSTGRES_DB=apibase
DATABASE_URL=
DATABASE_URL_WORKER=
DATABASE_URL_OUTBOX=
REDIS_URL=redis://redis:6379
API_KEY_SECRET=

# Testnet rails: x402 on Base Sepolia, MPP on Tempo testnet (chain 42431, pathUSD)
X402_NETWORK=base-sepolia
X402_PAYMENT_ADDRESS=
X402_FACILITATOR_MODE=remote
CDP_ENABLED=false
MPP_ENABLED=true
MPP_TESTNET=true
MPP_REALM=sandbox.apibase.pro
MPP_SECRET_KEY=
TEMPO_WALLET_ADDRESS=
TEMPO_PRIVATE_KEY=

# Integrator shop: same switches as production
INTEGRATOR_BASE_ORDERS_ENABLED=true
INTEGRATOR_FEE_ENABLED=true
INTEGRATOR_FEE_WALLET=
INTEGRATOR_TEST_SKU_DAILY_CAP=

# Provider credential the api validates at startup (any non-empty placeholder works here)
PROVIDER_KEY_OPENWEATHER=

# After launch, set SANDBOX_STATUS in the PRODUCTION env (not here) so /integrator and the agent
# guide link the sandbox; it is rendered through the SANDBOX_STATUS token, see scripts/sync-counts.sh.
