#!/usr/bin/env bash
# Reads the credential from stdin (silent), writes the 0600 key file, prints only "installed".
set +x
umask 077
IFS= read -rs val || true
val="${val//[$'\r\n ']/}"
[ -n "$val" ] || { echo "nothing on stdin" >&2; exit 1; }
# Key location rule: /var/lib/fleet-keys/<tenant>/ first (a directory owned by the caller), else the home file.
fk="${API_KEYS_BASE:-/var/lib/fleet-keys}/$(basename "$HOME")"
if [ -n "${API_KEY_FILE:-}" ]; then f="$API_KEY_FILE"
elif [ -d "$fk" ] && [ -O "$fk" ]; then f="$fk/anthropic-api.env"
else f="$HOME/.anthropic-api.env"; fi
tmp="$f.tmp.$$"
printf 'ANTHROPIC_API%s=%s\n' "_KEY" "$val" > "$tmp" && chmod 600 "$tmp" && mv -f "$tmp" "$f" || { rm -f "$tmp"; echo "install failed" >&2; exit 1; }
unset val
echo installed
